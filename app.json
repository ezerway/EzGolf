{
  "expo": {
    "name": "EzGolf",
    "slug": "ez-golf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ezgolf",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "UATKJXUFXL",
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ezerway.EzGolf",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow EzGolf to center the map on your location while you are on the course."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#25292e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.ezerway.ezgolf",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#25292e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#25292e",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow EzGolf to center the map on your location while you are on the course."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7f300267-f62c-4335-b24d-72d3e44cdf63"
      }
    },
    "owner": "ezerway"
  }
}
